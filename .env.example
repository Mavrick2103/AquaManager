# Database
DB_NAME=aquamanager
DB_USER=aquamanager
DB_PASS=aquamanager
DB_ROOT_PASS=rootpass

# JWT
JWT_SECRET=change_me_at_least_16_chars
JWT_EXPIRES=1h

# Agent marketing IA
OPENAI_MODEL_MARKETING=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
AQUAMANAGER_BRAND_LOGO_PATH=../front_end/web/public/Logo_AquaManger.png
PUBLIC_MEDIA_URL=https://aquamanager.fr
MARKETING_AGENT_WEEKLY_ENABLED=true

# Connexion Instagram avec Meta (à créer dans Meta for Developers)
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_INSTAGRAM_REDIRECT_URI=https://aquamanager.fr/api/admin/marketing/instagram/callback
META_INSTAGRAM_ACCOUNT_ID=
META_INSTAGRAM_ACCESS_TOKEN=
META_GRAPH_VERSION=v25.0
